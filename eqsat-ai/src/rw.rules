(rw (Add a b) (Add b a))
(rw (Mul a b) (Mul b a))
(rw (Mul a (Add b c)) (Add (Mul a b) (Mul a c)))

(rw (Sub a (Neg b)) (Add a b))
(rw (Sub (Neg a) b) (Neg (Add a b)))
(rw (Add a (Neg b)) (Sub a b))
(rw (Add (Neg a) b) (Sub b a))

(rw (And a b) (And b a))
(rw (Or a b) (Or b a))
(rw (Xor a b) (Xor b a))
(rw (Not (And a b)) (Or (Not a) (Not b)))
(rw (Not (Or a b)) (And (Not a) (Not b)))
(rw (Not (Xor a b)) (Xor (Not a) b))
(rw (Not (Xor a b)) (Xor a (Not b)))

(rw (Not (EE a b)) (NE a b))
(rw (Not (NE a b)) (EE a b))
(rw (Not (LT a b)) (GE a b))
(rw (Not (LE a b)) (GT a b))
(rw (Not (GT a b)) (LE a b))
(rw (Not (GE a b)) (LT a b))
(rw (LT a b) (GT b a))
(rw (LE a b) (GE b a))
(rw (GT a b) (LT b a))
(rw (GE a b) (LE b a))

(rw (Add a (Constant[i64] 0)) a)
(rw (Add a a) (Mul a (Constant[i64] 2)))
(rw (Sub a a) (Constant[i64] 0))
(rw (Sub (Constant[i64] 0) a) (Neg a))
(rw (Sub a (Constant[i64] 0)) a)
(rw (Mul _ (Constant[i64] 0)) (Constant[i64] 0))
(rw (Mul a (Constant[i64] 1)) a)
(rw (Mul a (Constant[i64] 2)) (Add a a))

(rw (EE a a) (Constant[bool] true))
(rw (NE a a) (Constant[bool] false))
(rw (LT a a) (Constant[bool] false))
(rw (LE a a) (Constant[bool] true))
(rw (GT a a) (Constant[bool] false))
(rw (GE a a) (Constant[bool] true))
(rw (EE (Sub a b) (Constant[i64] 0)) (EE a b))
(rw (NE (Sub a b) (Constant[i64] 0)) (NE a b))

(rw (Neg (Constant[i64] a)) (Constant[i64] `-a`))
(rw (Not (Constant[bool] a)) (Constant[bool] `!a`))

(rw (Add (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a + b`))
(rw (Sub (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a - b`))
(rw (Mul (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a * b`))
(rw (EE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a == b`))
(rw (NE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a != b`))
(rw (LT (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a < b`))
(rw (LE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a <= b`))
(rw (GT (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a > b`))
(rw (GE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a >= b`))

(rule (a:(Constant[bool] b) a:(Not c)) ((union c (Constant[bool] `!b`))))
(rule (a:(Constant[i64] b) a:(Neg c)) ((union c (Constant[i64] `-b`))))
(rule (a:(Constant[bool] true) a:(And b c)) ((union a (union b c))))
(rule (a:(Constant[bool] false) a:(Or b c)) ((union a (union b c))))
(rule (a:(Constant[bool] true) a:(EE b c)) ((union b c)))
(rule (a:(Constant[bool] false) a:(NE b c)) ((union b c)))
