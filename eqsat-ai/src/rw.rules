(rw (Add a b) (Add b a))
(rw (Add a (Add b c)) (Add (Add a b) c))
(rw (Mul a b) (Mul b a))
(rw (Mul a (Mul b c)) (Mul (Mul a b) c))
(rw (Mul a (Add b c)) (Add (Mul a b) (Mul a c)))

(rw (Sub a (Neg b)) (Add a b))
(rw (Sub (Neg a) b) (Neg (Add a b)))
(rw (Add a (Neg b)) (Sub a b))
(rw (Add (Neg a) b) (Sub b a))

(rw (Not (EE a b)) (NE a b))
(rw (Not (NE a b)) (EE a b))
(rw (Not (LT a b)) (GE a b))
(rw (Not (LE a b)) (GT a b))
(rw (Not (GT a b)) (LE a b))
(rw (Not (GE a b)) (LT a b))
(rw (LT a b) (GT b a))
(rw (LE a b) (GE b a))
(rw (GT a b) (LT b a))
(rw (GE a b) (LE b a))

(rw (Add a (Constant 0)) a)
(rw (Mul _ (Constant 0)) (Constant 0))
(rw (Mul a (Constant 1)) a)
(rw (Add a a) (Mul a (Constant 2)))
(rw (Mul a (Constant 2)) (Add a a))

(rw (EE a a) (Constant 1))
(rw (NE a a) (Constant 0))
(rw (LT a a) (Constant 0))
(rw (LE a a) (Constant 1))
(rw (GT a a) (Constant 0))
(rw (GE a a) (Constant 1))
(rw (EE (Sub a b) (Constant 0)) (EE a b))
