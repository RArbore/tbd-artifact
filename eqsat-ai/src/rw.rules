(rw (Add a b) (Add b a))
(rw (Mul a b) (Mul b a))

(rw (Sub a (Neg b)) (Add a b))
(rw (Sub (Neg a) b) (Neg (Add a b)))
(rw (Add a (Neg b)) (Sub a b))
(rw (Add (Neg a) b) (Sub b a))

(rw (BitwiseAnd a b) (BitwiseAnd b a))
(rw (BitwiseOr a b) (BitwiseOr b a))
(rw (BitwiseXor a b) (BitwiseXor b a))
(rw (And a b) (And b a))
(rw (Or a b) (Or b a))
(rw (Xor a b) (Xor b a))
(rw (BitwiseNot (BitwiseAnd a b)) (BitwiseOr (BitwiseNot a) (BitwiseNot b)))
(rw (BitwiseNot (BitwiseOr a b)) (BitwiseAnd (BitwiseNot a) (BitwiseNot b)))
(rw (BitwiseNot (BitwiseXor a b)) (BitwiseXor (BitwiseNot a) b))
(rw (BitwiseNot (BitwiseXor a b)) (BitwiseXor a (BitwiseNot b)))
(rw (Not (And a b)) (Or (Not a) (Not b)))
(rw (Not (Or a b)) (And (Not a) (Not b)))
(rw (Not (Xor a b)) (Xor (Not a) b))
(rw (Not (Xor a b)) (Xor a (Not b)))

(rw (Not (EE a b)) (NE a b))
(rw (Not (NE a b)) (EE a b))
(rw (Not (LT a b)) (GE a b))
(rw (Not (LE a b)) (GT a b))
(rw (Not (GT a b)) (LE a b))
(rw (Not (GE a b)) (LT a b))
(rw (EE a b) (EE b a))
(rw (NE a b) (NE b a))
(rw (LT a b) (GT b a))
(rw (LE a b) (GE b a))
(rw (GT a b) (LT b a))
(rw (GE a b) (LE b a))

(rw (Add a (Constant[i64] 0)) a)
(rw (Add a a) (Mul a (Constant[i64] 2)))
(rw (Sub a a) (Constant[i64] 0))
(rw (Sub (Constant[i64] 0) a) (Neg a))
(rw (Sub a (Constant[i64] 0)) a)
(rw (Mul _ (Constant[i64] 0)) (Constant[i64] 0))
(rw (Mul a (Constant[i64] 1)) a)
(rw (Mul a (Constant[i64] 2)) (Add a a))

(rw (And (Constant[bool] true) a) a)
(rw (And (Constant[bool] false) _) (Constant[bool] false))
(rw (Or (Constant[bool] false) a) a)
(rw (Or (Constant[bool] true) _) (Constant[bool] true))
(rw (Xor (Constant[bool] true) a) (Not a))
(rw (Xor (Constant[bool] false) a) a)
(rw (EE a a) (Constant[bool] true))
(rw (NE a a) (Constant[bool] false))
(rw (LT a a) (Constant[bool] false))
(rw (LE a a) (Constant[bool] true))
(rw (GT a a) (Constant[bool] false))
(rw (GE a a) (Constant[bool] true))
(rw (EE (Sub a b) (Constant[i64] 0)) (EE a b))
(rw (NE (Sub a b) (Constant[i64] 0)) (NE a b))

(rw (Neg (Constant[i64] a)) (Constant[i64] `-a`))
(rw (BitwiseNot (Constant[i64] a)) (Constant[i64] `!a`))
(rw (Not (Constant[bool] a)) (Constant[bool] `!a`))

(rw (Add (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a + b`))
(rw (Sub (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a - b`))
(rw (Mul (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a * b`))
(rw (BitwiseAnd (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a & b`))
(rw (BitwiseOr (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a | b`))
(rw (BitwiseXor (Constant[i64] a) (Constant[i64] b)) (Constant[i64] `a ^ b`))
(rw (And (Constant[bool] a) (Constant[bool] b)) (Constant[bool] `a & b`))
(rw (Or (Constant[bool] a) (Constant[bool] b)) (Constant[bool] `a | b`))
(rw (Xor (Constant[bool] a) (Constant[bool] b)) (Constant[bool] `a ^ b`))
(rw (EE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a == b`))
(rw (NE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a != b`))
(rw (LT (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a < b`))
(rw (LE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a <= b`))
(rw (GT (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a > b`))
(rw (GE (Constant[i64] a) (Constant[i64] b)) (Constant[bool] `a >= b`))

(rule (a:(Constant[i64] b) a:(Neg c)) ((union c (Constant[i64] `-b`))))
(rule (a:(Constant[i64] b) a:(BitwiseNot c)) ((union c (Constant[i64] `!b`))))
(rule (a:(Constant[bool] b) a:(Not c)) ((union c (Constant[bool] `!b`))))
(rule (a:(Constant[bool] true) a:(And b c)) ((union a b) (union b c)))
(rule (a:(Constant[bool] false) a:(Or b c)) ((union a b) (union b c)))
(rule (a:(Constant[bool] true) a:(EE b c)) ((union b c)))
(rule (a:(Constant[bool] false) a:(NE b c)) ((union b c)))

(rule (a:(Constant[i64] b)) ((KnownBits a `KnownBits::from_constant(b)`) (Interval a `Interval::from_constant(b)`)))
(rule (a:(Param[i64] _)) ((KnownBits a `KnownBits::top()`) (Interval a `Interval::Top`)))
(rule (a:(Knot[i64] kb int _)) ((KnownBits a kb) (Interval a int)))

(rule (a:(Neg b) (KnownBits b kb)) ((KnownBits a `kb.neg()`)))
(rule (a:(BitwiseNot b) (KnownBits b kb)) ((KnownBits a `kb.bitwise_not()`)))

(rule (a:(Neg b) (Interval b int)) ((Interval a `int.neg()`)))
(rule (a:(BitwiseNot b) (Interval b int)) ((Interval a `int.bitwise_not()`)))

(rule (a:(Add b c) (KnownBits b b_kb) (KnownBits c c_kb)) ((KnownBits a `b_kb.add(&c_kb)`)))
(rule (a:(Sub b c) (KnownBits b b_kb) (KnownBits c c_kb)) ((KnownBits a `b_kb.sub(&c_kb)`)))
(rule (a:(Mul b c) (KnownBits b b_kb) (KnownBits c c_kb)) ((KnownBits a `b_kb.mul(&c_kb)`)))
(rule (a:(BitwiseAnd b c) (KnownBits b b_kb) (KnownBits c c_kb)) ((KnownBits a `b_kb.bitwise_and(&c_kb)`)))
(rule (a:(BitwiseOr b c) (KnownBits b b_kb) (KnownBits c c_kb)) ((KnownBits a `b_kb.bitwise_or(&c_kb)`)))
(rule (a:(BitwiseXor b c) (KnownBits b b_kb) (KnownBits c c_kb)) ((KnownBits a `b_kb.bitwise_xor(&c_kb)`)))

(rule (a:(Add b c) (Interval b b_int) (Interval c c_int)) ((Interval a `b_int.add(&c_int)`)))
(rule (a:(Sub b c) (Interval b b_int) (Interval c c_int)) ((Interval a `b_int.sub(&c_int)`)))
(rule (a:(Mul b c) (Interval b b_int) (Interval c c_int)) ((Interval a `b_int.mul(&c_int)`)))
(rule (a:(BitwiseAnd b c) (Interval b b_int) (Interval c c_int)) ((Interval a `b_int.bitwise_and(&c_int)`)))
(rule (a:(BitwiseOr b c) (Interval b b_int) (Interval c c_int)) ((Interval a `b_int.bitwise_or(&c_int)`)))
(rule (a:(BitwiseXor b c) (Interval b b_int) (Interval c c_int)) ((Interval a `b_int.bitwise_xor(&c_int)`)))

(rule ((KnownBits a kb)) `let Some(cons) = kb.try_constant()` ((union a (Constant[i64] `cons`))))
(rule ((Interval a int)) `let Some(cons) = int.try_constant()` ((union a (Constant[i64] `cons`))))

(rule (a:(Constant[bool] true) a:(LT b (Constant[i64] c))) `let Some(c_minus_one) = c.checked_sub(1)` ((Interval b `Interval::from_high(c_minus_one)`)))
(rule (a:(Constant[bool] true) a:(LE b (Constant[i64] c))) ((Interval b `Interval::from_high(c)`)))
(rule (a:(Constant[bool] true) a:(GT b (Constant[i64] c))) `let Some(c_plus_one) = c.checked_add(1)` ((Interval b `Interval::from_low(c_plus_one)`)))
(rule (a:(Constant[bool] true) a:(GE b (Constant[i64] c))) ((Interval b `Interval::from_low(c)`)))
(rule (a:(Constant[bool] false) a:(LT b (Constant[i64] c))) ((Interval b `Interval::from_low(c)`)))
(rule (a:(Constant[bool] false) a:(LE b (Constant[i64] c))) `let Some(c_plus_one) = c.checked_add(1)` ((Interval b `Interval::from_low(c_plus_one)`)))
(rule (a:(Constant[bool] false) a:(GT b (Constant[i64] c))) ((Interval b `Interval::from_high(c)`)))
(rule (a:(Constant[bool] false) a:(GE b (Constant[i64] c))) `let Some(c_minus_one) = c.checked_sub(1)` ((Interval b `Interval::from_high(c_minus_one)`)))

(rule ((Interval a int)) `int.leq(&Interval::from_high(-1))` ((KnownBits a `KnownBits::from_low_high_concrete(!0i64, 1i64 << 63)`)))
(rule ((Interval a int)) `int.leq(&Interval::from_low(0))` ((KnownBits a `KnownBits::from_low_high_concrete(!(1i64 << 63), 1i64 << 63)`)))

(rule (a:(Constant[i64] b) a:(Constant[i64] c)) `b != c` (contradiction))
(rule (a:(Constant[bool] true) a:(Constant[bool] false)) (contradiction))
