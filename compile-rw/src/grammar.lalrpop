use core::str::FromStr;

use symbol_table::GlobalSymbol as Symbol;

use crate::{Literal, Pattern, Rule, Type};

grammar();

pub Rules: Vec<Rule> = {
    Rule* => <>,
}

Rule: Rule = {
    "(" "rw" <mut lhs:Pattern> <rhs:Pattern> ")" => {
        let root_lhs = lhs.label_mut();
        let label = match root_lhs {
            Some(label) => *label,
            None => {
                 let label = "_root_lhs".into();
                 *root_lhs = Some(label);
                 label
            }
        };
        let rhs = Pattern::Union(Box::new(Pattern::Variable(label)), Box::new(rhs));
        Rule { lhs: vec![lhs], rhs: vec![rhs] }
    },
    "(" "rule" "(" <lhs:Pattern*> ")" "(" <rhs:Pattern*> ")" ")" => Rule { lhs, rhs },
}

Pattern: Pattern = {
    Iden => Pattern::Variable(<>),
    Num => Pattern::Literal(Literal::I64(<>)),
    Bool => Pattern::Literal(Literal::Bool(<>)),
    RustExpr => Pattern::RustExpr(<>),
    "(" "union" <lhs:Pattern> <rhs:Pattern> ")" => Pattern::Union(Box::new(lhs), Box::new(rhs)),
    "_" => Pattern::Wildcard,
    "(" "Constant" "[" <ty:Type> "]" <cons:Pattern> ")" => Pattern::Constant { ty, input: Box::new(cons), label: None },
    "(" <op:Iden> <inp:Pattern> ")" => Pattern::Unary { op, input: Box::new(inp), label: None },
    "(" <op:Iden> <lhs:Pattern> <rhs:Pattern> ")" => Pattern::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs), label: None },
    <label:Iden> ":" "(" "Constant" "[" <ty:Type> "]" <cons:Pattern> ")" => Pattern::Constant { ty, input: Box::new(cons), label: Some(label) },
    <label:Iden> ":" "(" <op:Iden> <inp:Pattern> ")" => Pattern::Unary { op, input: Box::new(inp), label: Some(label) },
    <label:Iden> ":" "(" <op:Iden> <lhs:Pattern> <rhs:Pattern> ")" => Pattern::Binary { op, lhs: Box::new(lhs), rhs: Box::new(rhs), label: Some(label) },
}

Type: Type = {
    "i64" => Type::I64,
    "bool" => Type::Bool,
}

Iden: Symbol = r"[a-zA-Z][a-zA-Z0-9_]*" => Symbol::from(<>);
Num: i64 = r"-?[0-9]+" => i64::from_str(<>).unwrap();
Bool: bool = {
    "false" => false,
    "true" => true,
}
RustExpr: Symbol = <re:r#"`(\\\\|\\`|[^`\\])*`"#> => re[1..re.len() - 1].into();
